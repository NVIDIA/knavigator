matches the default-values snapshot:
  1: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      name: nre-node-resource-exporter
    rules:
      - apiGroups:
          - ""
        resources:
          - '*'
        verbs:
          - get
          - list
          - watch
  2: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRoleBinding
    metadata:
      name: nre-node-resource-exporter
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: ClusterRole
      name: nre-node-resource-exporter
    subjects:
      - apiGroup: ""
        kind: ServiceAccount
        name: nre-node-resource-exporter
        namespace: monitoring
