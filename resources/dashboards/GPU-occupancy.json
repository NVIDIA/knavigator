      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 4,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "maxHeight": 600,
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "avg(node_resource_occupancy{resource=\"nvidia.com/gpu\"})",
          "instant": false,
          "interval": "10s",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Avg. node GPU occupancy (%)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Wasted GPU-hours: GPU time that sat idle while pods were waiting for GPUs. At each moment it counts the smaller of (a) GPUs not requested by any pod and (b) GPUs requested by pods still waiting to be placed, and adds that up over the time range shown. Idle time with nothing waiting is not counted. See the idle panel for that.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2,
          "noValue": "No GPU data yet",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "id": 10,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum_over_time((((sum(kube_node_status_allocatable{resource=\"nvidia_com_gpu\"}) - sum(node_resource_requests{resource=\"nvidia.com/gpu\"})) < sum(kube_pod_container_resource_requests{resource=\"nvidia_com_gpu\"} * on(namespace, pod) group_left() (kube_pod_status_phase{phase=\"Pending\"} == 1))) or sum(kube_pod_container_resource_requests{resource=\"nvidia_com_gpu\"} * on(namespace, pod) group_left() (kube_pod_status_phase{phase=\"Pending\"} == 1)) or vector(0))[$__range:$__interval]) * $__interval_ms / 3600000",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Wasted GPU-hours (selected range)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Idle GPU-hours: GPU time not requested by any pod, whether or not work was waiting. This is a different metric from wasted GPU-hours, which only counts idle time while pods were waiting.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2,
          "noValue": "No GPU data yet",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "id": 11,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum_over_time((sum(kube_node_status_allocatable{resource=\"nvidia_com_gpu\"}) - sum(node_resource_requests{resource=\"nvidia.com/gpu\"}))[$__range:$__interval]) * $__interval_ms / 3600000",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Idle GPU-hours (selected range)",
      "type": "stat"
    }
  ],
