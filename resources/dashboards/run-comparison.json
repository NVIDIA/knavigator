  "templating": {
    "list": [
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "query_result(push_time_seconds{job=\"knavigator\"})",
        "hide": 0,
        "includeAll": true,
        "label": "Run",
        "multi": true,
        "name": "run",
        "options": [],
        "query": {
          "query": "query_result(push_time_seconds{job=\"knavigator\"})",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "/run=\"([^\"]+)\"/",
        "skipUrlSync": false,
        "sort": 2,
        "type": "query",
        "description": "Runs to compare. The Pushgateway holds these runs now; delete a run from the gateway to drop it from this list."
      }
    ]
