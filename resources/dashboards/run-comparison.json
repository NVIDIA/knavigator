              "Value #A": "GPU utilization",
              "Value #B": "Makespan",
              "Value #C": "Jobs started",
              "Value #D": "Jobs",
              "Value #E": "Mean job wait",
              "Value #F": "P95 job wait",
              "Value #G": "Max job wait",
